# Single configuration file for Swarm karaoke pipeline
# Copy to .env and fill in values.

# --- Supabase (job tracking) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- S3-compatible storage (Runpod S3, MinIO, etc.) ---
S3_ENDPOINT=https://s3api.runpod.io
S3_BUCKET=karaoke
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# --- Home agent ---
WORKER_ID=home-agent-1
POLL_INTERVAL=30
LEASE_SECONDS=900
MAX_ATTEMPTS=3
DOWNLOAD_DIR=/var/lib/karaoke-agent/spool

# Capability flags (must reflect the actual host)
HAS_NVIDIA_GPU=false
DEMUCS_AVAILABLE=false

# --- Runpod (remote splitting path) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_POLL_INTERVAL=15

# Optional: if set, the agent will mark jobs as published and set public_url
# to {PUBLIC_BASE_URL}/{s3_output_prefix}
PUBLIC_BASE_URL=
